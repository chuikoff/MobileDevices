    GROUPBOX        "Time",IDC_TIME_GROUP,7,126,286,108
    CONTROL         "Local new",IDC_LOCALTIME_NEW,"Button",BS_AUTORADIOBUTTON | WS_GROUP,12,142,276,10
    CONTROL         "Local old",IDC_LOCALTIME_OLD,"Button",BS_AUTORADIOBUTTON,12,156,276,10
    CONTROL         "UTC",IDC_UNIVERSALTIME,"Button",BS_AUTORADIOBUTTON,12,170,276,10
