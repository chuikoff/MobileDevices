IDD_DEVICEINFO DIALOGEX 0, 0, 320, 200
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Mobile Devices"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_DEVICE_INFO,7,7,306,168,ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER | NOT WS_TABSTOP
    DEFPUSHBUTTON   "OK",IDOK,263,180,50,14
END

IDD_PLUGINABOUT DIALOGEX 0, 0, 280, 128
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Mobile Devices"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_PLUGIN_ICON,"Static",SS_ICON | SS_CENTERIMAGE | SS_REALSIZECONTROL,12,10,32,32
    LTEXT           "Mobile Devices",IDC_ABOUT_TITLE,52,12,216,12
    LTEXT           "Version",IDC_ABOUT_VER,52,26,216,10
    LTEXT           "desc",IDC_ABOUT_DESC,12,50,256,28
    CONTROL         "<a>GitHub</a>",IDC_GITHUB_LINK,"SysLink",WS_TABSTOP,12,84,256,16
    DEFPUSHBUTTON   "OK",IDOK,223,108,50,14
END


